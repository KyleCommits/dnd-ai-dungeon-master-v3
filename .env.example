# Local LLM Configuration (Primary DM narrator)
LOCAL_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
LOCAL_MODEL_PATH="path/to/your/llama/model"
VLLM_HOST=localhost
VLLM_PORT=8000
GPU_MEMORY_UTILIZATION=0.9
MAX_MODEL_LEN=4096
TENSOR_PARALLEL_SIZE=1

# Small intent interpreter (player text → JSON; CPU by default to spare VRAM)
INTENT_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
INTENT_DEVICE=cpu
INTENT_TIMEOUT_SEC=12
INTENT_MAX_NEW_TOKENS=80
INTENT_RULES_FALLBACK=false

# LlamaIndex Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
SIMILARITY_TOP_K=5
VECTOR_STORE_DIM=384

# API Keys (Required)
GEMINI_API_KEY="your_gemini_api_key_here"
XAI_API_KEY="your_xai_api_key_here"

# Discord & Database
# Local fresh-start example (see scripts/LOCAL_DB_SETUP.md). Change the password if you want.
DATABASE_URL="postgresql+asyncpg://dnd:dnd_local@localhost:5432/dnd_bot_v3"
DISCORD_TOKEN="your_discord_bot_token_here"
BOT_CHANNEL_ID="your_channel_id_here"
OWNER_ID="your_discord_user_id_here"

# File Paths
CAMPAIGN_PDF_PATH="path/to/your/campaigns/folder"
SRD_PDF_PATH="path/to/your/SRD-OGL_V5.1.pdf"
INDEX_STORAGE_PATH=./indexes