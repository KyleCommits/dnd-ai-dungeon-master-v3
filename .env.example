# DM narrator backend: gemini (Dell / no GPU) or local (Alienware CUDA Transformers)
DM_BACKEND=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=400
GEMINI_TIMEOUT_SEC=30

# Local LLM Configuration (DM_BACKEND=local only)
# Default (L1): Mistral 7B Instruct — gated; accept license + `huggingface-cli login` first.
# Fallback quality path: meta-llama/Llama-3.1-8B-Instruct (also gated).
LOCAL_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3
LOCAL_MODEL_PATH="path/to/your/llama/model"
# 4bit nf4 on GPU (no CPU offload). Set LOCAL_QUANTIZATION=8bit to use 8-bit instead.
LOCAL_LOAD_IN_4BIT=true
LOCAL_QUANTIZATION=4bit
MAX_MODEL_LEN=4096

# Intent interpreter (player text -> action + slots)
# embed = MiniLM kNN over data/intent/examples.jsonl (default, free, ~10ms)
# llm   = legacy Qwen2.5-1.5B JSON generation, kept for eval comparison only.
#         It has no mechanics gate; do not run a real game on it.
INTENT_BACKEND=embed
INTENT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
INTENT_EMBED_K=5
# Minimum classifier margin before an attack or cast may change game state.
# Calibrated with scripts/eval_intent.py; see the README section on intent data.
# Raising this does not make the bot safer, it silently turns real attacks into
# narration. Fix misroutes by adding labeled examples instead.
INTENT_MECHANICS_MARGIN=0.02

# Legacy llm backend only (CPU by default to spare VRAM)
INTENT_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
INTENT_DEVICE=cpu
INTENT_TIMEOUT_SEC=20
INTENT_MAX_NEW_TOKENS=100
INTENT_RULES_FALLBACK=false

# LlamaIndex Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
SIMILARITY_TOP_K=5
VECTOR_STORE_DIM=384

# API Keys (Required)
GEMINI_API_KEY="your_gemini_api_key_here"
XAI_API_KEY="your_xai_api_key_here"

# Discord & Database
# Local fresh-start example (see scripts/LOCAL_DB_SETUP.md). Change the password if you want.
DATABASE_URL="postgresql+asyncpg://dnd:dnd_local@localhost:5432/dnd_bot_v3"
DISCORD_TOKEN="your_discord_bot_token_here"
BOT_CHANNEL_ID="your_channel_id_here"
OWNER_ID="your_discord_user_id_here"

# File Paths
CUSTOM_CAMPAIGN_PATH=dnd_src_material/custom_campaigns
CAMPAIGN_PDF_PATH=dnd_src_material/campaigns
SRD_PDF_PATH=dnd_src_material/rules_and_supplements/SRD-OGL_V5.1.pdf
INDEX_STORAGE_PATH=./indexes
